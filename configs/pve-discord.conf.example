# Central Discord Webhook Configuration for Proxmox VE
# Copy this file to /etc/pve-discord.conf and insert your real Webhook URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_USERNAME="PVE-Monitor"
DISCORD_AVATAR="https://avatars.githubusercontent.com/u/4925769?s=200&v=4"
