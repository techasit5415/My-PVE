SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Short Test (1-2 mins): Everyday at 03:00 AM
0 3 * * * root /usr/local/bin/pve-smart-test.sh short > /dev/null 2>&1

# Long / Extended Test (2-4 hrs): Every 2 weeks (1st and 15th of the month at 02:00 AM)
0 2 1,15 * * root /usr/local/bin/pve-smart-test.sh long > /dev/null 2>&1